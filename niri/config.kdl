input {
        keyboard {
                xkb {
                        layout "us,br,de"
                        options "grp:win_space_toggle,ctrl:nocaps"
                }
                repeat-delay 300
                repeat-rate 80
        }
        mouse {
                accel-profile "flat"
        }
}

spawn-at-startup "lxpolkit"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "discord"
spawn-at-startup "swaybg -i ~/Wallpapers/wolf_fox.jpg"
// spawn-at-startup "dbus-update-activation-environment" "--systemd" "DISPLAY" "WAYLAND_DISPLAY" "SWAYSOCK" "XDG_CURRENT_DESKTOP"
// spawn-at-startup "systemctl" "--user" "import-environment" "DISPLAY" "WAYLAND_DISPLAY" "SWAYSOCK" "XDG_CURRENT_DESKTOP"

prefer-no-csd

layout {
        gaps 4
        struts {
                left 8
                right 8
                top 8
                bottom 9
        }
        background-color "#262626"

        center-focused-column "never"
        default-column-display "tabbed"

        default-column-width { proportion 1.0; }

        focus-ring {
                off
        }
        border {
                on
                width 4
                active-color "#ea9875"
                inactive-color "#6C6C6C"
        }
        shadow{
                on
        }
}

window-rule {
        match app-id="discord"
        open-on-workspace "6"
}

binds {
        Mod+Return { spawn "alacritty"; }
        Mod+C { close-window; }
        Mod+E { spawn "nautilus"; }
        Mod+V { toggle-window-floating; }
        Mod+F { fullscreen-window; }
        Mod+R { spawn "~/.config/rofi/launcher.sh"; }
        Mod+Shift+Delete { spawn "~/.config/rofi/powermenu.sh"; }
        Mod+Shift+C { quit; }

        Mod+Y { spawn "~/.config/rofi/cliphistory.sh"; }
        Mod+P { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
        Mod+I { spawn "sh" "-c" "hyprpicker | wl-copy"; }
        Mod+Shift+R { spawn "foot" "~/.config/scripts/reader.sh"; }

        Mod+H { focus-column-left; }
        Mod+L { focus-column-right; }
        Mod+Ctrl+J { focus-window-down; }
        Mod+Ctrl+K { focus-window-up; }

        Mod+Shift+H { move-column-left; }
        Mod+Shift+L { move-column-right; }
        Mod+Shift+J { move-window-down; }
        Mod+Shift+K { move-window-up; }

        Mod+BracketLeft  { consume-window-into-column; }
        Mod+BracketRight { expel-window-from-column; }

        Mod+J { focus-workspace-down; }
        Mod+K { focus-workspace-up; }

        Mod+Shift+1 { move-column-to-workspace 1; }
        Mod+Shift+2 { move-column-to-workspace 2; }
        Mod+Shift+3 { move-column-to-workspace 3; }
        Mod+Shift+4 { move-column-to-workspace 4; }
        Mod+Shift+5 { move-column-to-workspace 5; }
        Mod+Shift+6 { move-column-to-workspace 6; }
        Mod+Shift+7 { move-column-to-workspace 7; }
        Mod+Shift+8 { move-column-to-workspace 8; }
        Mod+Shift+9 { move-column-to-workspace 9; }

        Mod+Ctrl+Shift+J { move-column-to-workspace-down; }
        Mod+Ctrl+Shift+K { move-column-to-workspace-up; }

        Mod+W { toggle-column-tabbed-display; }


        Mod+1 { focus-workspace 1; }
        Mod+2 { focus-workspace 2; }
        Mod+3 { focus-workspace 3; }
        Mod+4 { focus-workspace 4; }
        Mod+5 { focus-workspace 5; }
        Mod+6 { focus-workspace 6; }
        Mod+7 { focus-workspace 7; }
        Mod+8 { focus-workspace 8; }
        Mod+9 { focus-workspace 9; }

        Mod+Shift+F { maximize-column; }

        Mod+Alt+H { set-column-width "-10%"; }
        Mod+Alt+L { set-column-width "+10%"; }

        Mod+Alt+J { set-window-height "+10%"; }
        Mod+Alt+K { set-window-height "-10%"; }
}
