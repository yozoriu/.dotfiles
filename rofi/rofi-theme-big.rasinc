configuration {
font: "Cascadia Code NF 10";
      show-icons: true;
      click-to-exit: true;
}

* {
bg: #000000;
fg: #eeeeee;
acc: #6F6E69;
    background-color: @bg;
}

window {
        border-color: @acc;
border: 0px;
margin: 50px;
width: 100%;
height: 100%;
anchor: south;
location: north;
}

element-icon {
size: 110px;
}

entry {
        background-color: @bg;
        text-color: @fg;
}

element-text selected {
        text-color: @acc;
}

listview {
columns: 4;
dynamic: false;
}

element-text {
margin: 4px;
        text-color: @fg;
}
